<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:label="Smart Home Dashboard"
        android:theme="@style/Theme.App"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">
        <activity android:name="com.example.smarthomefull.RegistrationActivity" android:exported="false"/>
        <activity android:name="com.example.smarthomefull.RoomActivity" android:exported="false"/>
        <activity android:name="com.example.smarthomefull.DashboardActivity" android:exported="false"/>
        <activity android:name="com.example.smarthomefull.ESP32SettingsActivity" android:exported="false"/>
        <activity android:name="com.example.smarthomefull.LoginActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Background service to sync deviceMapping changes to room structure -->
        <service
            android:name="com.example.smarthomefull.DeviceSyncService"
            android:enabled="true"
            android:exported="false" />
    </application>
</manifest>
